# AI NEWS FACTORY - Environment Configuration Template
# Copy this file to .env and configure your secrets locally.
# DO NOT COMMIT .env TO GIT!

# Factory Configuration
FACTORY_MODE=dry_run
FACTORY_TIMEZONE=Asia/Ho_Chi_Minh

# YouTube Publishing (Phase 3+)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# AI & Generation Services (Phase 3+)
# TTS Provider (e.g., ElevenLabs / OpenAI)
TTS_API_KEY=
TTS_VOICE_ID=

# Image / Video Generation Provider
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=

# News Research & Search APIs (Optional)
NEWS_SEARCH_API_KEY=
